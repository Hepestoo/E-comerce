{
  "buildCommand": "ng build --configuration=production",
  "outputDirectory": "dist/front/browser",
  "framework": "angular",
  "devCommand": "ng serve",
  "install": "npm install",
  "env": {
    "NEXT_PUBLIC_API_URL": "@artemania_api_url"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 200
    }
  ]
}
